      "id": "649d15ac-e74e-4619-a0b7-664508bcea32",
      "name": "selecao"
    },
    {
      "parameters": {
        "jsCode": "const selecao = $('selecao').first().json.selecao;\nconst itens = $input.all().map(i => i.json);\n\nconst fmt = (n) => Number(n).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });\nconst norm = (s) => String(s).normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().trim();\n\nconst escolhidos = norm(selecao) === 'todas'\n  ? itens\n  : itens.filter(i => norm(i.nome) === norm(selecao));\n\nif (escolhidos.length === 0) {\n  return [{ json: { mensagem: `Não encontrei \"${selecao}\". Itens recebidos (${itens.length}): ${itens.map(i => i.nome).join(', ') || 'nenhum'}` } }];\n}\n\nconst linhas = escolhidos.map(i =>\n  i.moeda_original === 'BRL'\n    ? `• ${i.nome}: ${fmt(i.preco_brl_referencia)} (cota do ETF BBOI11, só uma referência, não é o preço da arroba)`\n    : `• ${i.nome}: ${fmt(i.preco_brl_referencia)} por ${i.unidade_referencia}`\n);\n\nconst aviso = 'Valores calculados a partir de cotações internacionais (futuros) convertidas para reais. Não substituem a cotação física da sua região.';\n\nreturn [{ json: { mensagem: `Cotações atuais em reais:\\n\\n${linhas.join('\\n')}\\n\\n${aviso}` } }];"
      },
