    {
      "parameters": {
        "jsCode": "const resposta = $input.item.json;\nconst meta = resposta.chart.result[0].meta;\nconst ticker = meta.symbol;\nconst rates = $('Edit Fields3').first().json.rates;\n\nconst precoBruto = meta.regularMarketPrice;\n\nconst config = {\n  \"ZS=F\": { nome: \"Soja\", kgPorUnidade: 27.2155, pesoRefKg: 60, referencia: \"saca de 60kg\" },\n  \"ZC=F\": { nome: \"Milho\", kgPorUnidade: 25.401, pesoRefKg: 60, referencia: \"saca de 60kg\" },\n  \"KC=F\": { nome: \"Café\", kgPorUnidade: 0.453592, pesoRefKg: 60, referencia: \"saca de 60kg\" },\n  \"SB=F\": { nome: \"Açúcar\", kgPorUnidade: 0.453592, pesoRefKg: 50, referencia: \"saca de 50kg\" },\n  \"CT=F\": { nome: \"Algodão\", kgPorUnidade: 0.453592, pesoRefKg: 15, referencia: \"arroba (15kg)\" },\n  \"BBOI11.SA\": { nome: \"Boi Gordo\", direto: true, referencia: \"cota do ETF (referência, não é o preço da arroba)\" }\n};\n\nconst c = config[ticker];\nif (!c) {\n  throw new Error(`Ticker não configurado: ${ticker}`);\n}\n\nif (c.direto) {\n  return { json: { nome: c.nome, ticker, preco_brl_referencia: precoBruto, unidade_referencia: c.referencia, moeda_original: \"BRL\" } };\n}\n\nconst precoUsd = precoBruto / 100; // centavos -> dólares\nconst unidadesPorReferencia = c.pesoRefKg / c.kgPorUnidade;\nconst precoBrl = precoUsd * rates.BRL * unidadesPorReferencia;\n\nreturn { json: { nome: c.nome, ticker, preco_usd: precoUsd, preco_brl_referencia: precoBrl, unidade_referencia: c.referencia, moeda_original: \"USD\" } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1408,
        1008
      ],
      "id": "363e4e2e-2949-4bc7-81e8-276ec667521a",
      "name": "Code in JavaScript"
    },
